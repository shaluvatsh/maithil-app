# Copy to .env and fill in. `.env` is gitignored; never commit real values.
#
# Only the first block is needed to run locally — everything under "External
# services" is optional in development and the app degrades honestly without it
# (uploads go to an in-process store, payments use a fake gateway, messages are
# logged instead of sent). In PRODUCTION most of it is REQUIRED and the process
# refuses to boot without it — see the bottom of apps/api/src/common/config.ts.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://themaithil:themaithil@localhost:5432/themaithil
# DB_POOL_MAX=10   # shared by every request AND both background workers on this instance; raise for a busier deployment
REDIS_URL=redis://localhost:6379

# Any random 32+ character strings locally. In production generate real ones:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-32-chars-minimum-please!!
JWT_REFRESH_SECRET=change-me-too-32-chars-minimum!!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Ops
LAUNCH_CITY_SLUG=kolkata
BOOKING_HORIZON_DAYS=120
# Fixes every login code to 123456 and returns it in the response. REFUSED in
# production — loadConfig() throws rather than boot with it on.
OTP_DEV_BYPASS=true

# Can this deployment take money online?
#
# TRUE by default. Set it to false to run CASH-ONLY: no token is charged, a booking
# confirms the moment it is submitted, and the devotee pays the purohit the full
# amount on the day. Production may then boot without RAZORPAY_* — that is the only
# thing this flag relaxes about credentials.
#
# REVENUE CONSEQUENCE, worth reading before turning it off. The platform fee lives
# INSIDE the token (see packages/contracts/src/pricing.ts), precisely so the purohit
# is never asked to remit anything. With no token there is no fee collected on any
# booking, and no due is recorded for it. Collecting in arrears is a commercial
# decision about what purohits were told, not a config change.
PAYMENTS_ENABLED=true
# Where the assistant sends people to review and pay for a draft booking.
WEB_BASE_URL=http://localhost:3001


# ─── External services ────────────────────────────────────────────────────────

# Payments — Razorpay Route. https://dashboard.razorpay.com → Settings → API Keys.
# The webhook secret is separate: Settings → Webhooks → Add, then copy the secret
# you set there. Required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Document storage — Cloudflare R2. dash.cloudflare.com → R2 → Manage API Tokens.
# The endpoint is https://<account-id>.r2.cloudflarestorage.com
# Required in production: without it, KYC uploads appear to succeed and are lost.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# WhatsApp — your BSP (Gupshup, Interakt, AiSensy). API key and the sender number
# come from the BSP console once the WhatsApp Business account is approved.
# Required in production: without it, login codes go to the server log and nobody
# can sign in.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# Signs the BSP's inbound webhook, so nobody can post messages pretending to be
# someone else's number. Generate one and paste the SAME value into the BSP's
# webhook configuration:  openssl rand -hex 32
# Without it the inbound endpoint refuses everything rather than falling open.
WHATSAPP_INBOUND_SECRET=

# SMS fallback — MSG91. https://control.msg91.com → API keys.
# Optional even in production: it degrades delivery rather than breaking it.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MAITHL

# Transactional email — the password reset link, and nothing else today.
#
# WITHOUT THIS the reset link is written to the SERVER LOG instead of being sent.
# The caller gets a cheerful {ok:true} and the devotee gets nothing, so someone who
# forgets their password can never get back in. Production refuses to boot with
# neither this nor a messaging provider, for exactly that reason.
#
# RESEND, verified against its published API on 29 Oct 2026 — the values below are
# literal, not placeholders:
#
#   EMAIL_API_URL=https://api.resend.com/emails
#   EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxx        (Resend dashboard → API Keys)
#   EMAIL_FROM=TheMaithil <no-reply@themaithil.in>
#
# The API key is the easy half. The half that decides whether mail ARRIVES is
# verifying the sending domain: add Resend's SPF and DKIM records to themaithil.in
# and wait for them to go green. Until they do, mail either lands in Spam or is
# rejected outright — and that is a DNS change, not a code change.
#
# Then prove it, before a devotee depends on it:
#   node apps/api/src/scripts/smoke-email.mjs you@example.com
#
# Other providers need a different channel, not different values here: SendGrid
# wants a `personalizations` array and SES wants SigV4 signing. See
# modules/notifications/email-channel.ts.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# The assistant — console.anthropic.com → API keys.
# Optional everywhere: with no key the assistant declines politely and the rest of
# the product is unaffected.
ANTHROPIC_API_KEY=
